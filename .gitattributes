# Keep text files in LF in Git and in working trees on every platform.
* text=auto eol=lf

# Windows batch files use CRLF in the working tree.
*.bat text eol=crlf
*.cmd text eol=crlf

# Explicit binary formats.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.glb binary
*.bin binary
